generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LinkType {
  COLLECTION
  PRODUCT
  CUSTOM
}

model User {
  id        String   @id @default(uuid())
  authId    String   @unique
  role      UserRole @default(CUSTOMER)
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]

  @@index([role])
}

model Category {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  image       String?
  description String?
  sortOrder   Int           @default(0)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  products Product[]

  @@index([status])
  @@index([sortOrder])
}

model Collection {
  id          String              @id @default(uuid())
  name        String
  slug        String              @unique
  image       String?
  description String?
  sortOrder   Int                 @default(0)
  status      ContentStatus       @default(DRAFT)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  productCollections ProductCollection[]

  @@index([status])
  @@index([sortOrder])
}

model Product {
  id                String        @id @default(uuid())
  name              String
  slug              String        @unique
  sku               String        @unique
  shortDescription  String?
  description       String?
  regularPrice      Decimal       @db.Decimal(10, 2)
  discountPercent   Decimal       @default(0) @db.Decimal(5, 2)
  categoryId        String
  stockQuantity     Int           @default(0)
  lowStockThreshold Int           @default(3)
  isNewArrival      Boolean       @default(false)
  isFeatured        Boolean       @default(false)
  status            ProductStatus @default(DRAFT)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  category           Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  specification      ProductSpecification?
  images             ProductImage[]
  productCollections ProductCollection[]

  @@index([categoryId])
  @@index([status])
  @@index([isNewArrival])
  @@index([isFeatured])
  @@index([createdAt])
}

model ProductSpecification {
  id                  String   @id @default(uuid())
  productId           String   @unique
  fabric              String?
  colour              String?
  sareeLength         Decimal? @db.Decimal(5, 2)
  blousePieceIncluded Boolean  @default(false)
  blousePieceLength   Decimal? @db.Decimal(5, 2)
  workWeave           String?
  occasion            String?
  careInstructions    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, sortOrder])
}

model ProductCollection {
  productId    String
  collectionId String
  createdAt    DateTime   @default(now())

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId])
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  recipientName String
  phone         String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  pinCode       String
  country       String   @default("India")
  landmark      String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CampaignBanner {
  id           String    @id @default(uuid())
  name         String
  desktopImage String
  mobileImage  String?
  linkType     LinkType
  linkValue    String
  startDate    DateTime?
  endDate      DateTime?
  isActive     Boolean   @default(false)
  priority     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive])
  @@index([priority])
}

model StoreSettings {
  id          String   @id @default(uuid())
  storeName   String
  email       String?
  phone       String?
  whatsapp    String?
  address     String?
  logo        String?
  favicon     String?
  socialLinks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShippingSettings {
  id                      String   @id @default(uuid())
  standardShippingAmount  Decimal  @default(0) @db.Decimal(10, 2)
  freeShippingThreshold   Decimal? @db.Decimal(10, 2)
  isShippingEnabled       Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}